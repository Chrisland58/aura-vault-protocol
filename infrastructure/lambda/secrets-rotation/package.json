{
  "name": "@aura-vault/secrets-rotation",
  "version": "1.0.0",
  "description": "AWS Lambda functions for automated secrets rotation — database passwords and JWT secrets",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/db-rotation.ts src/jwt-rotation.ts --bundle --platform=node --target=node20 --outdir=dist --external:@aws-sdk --minify",
    "build:dev": "esbuild src/db-rotation.ts src/jwt-rotation.ts --bundle --platform=node --target=node20 --outdir=dist --external:@aws-sdk --sourcemap",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist coverage",
    "package": "npm run clean && npm run build && cd dist && zip -r ../lambda-deployment.zip ."
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.600.0",
    "@aws-sdk/client-rds": "3.600.0",
    "@aws-sdk/client-cloudwatch": "3.600.0",
    "pg": "8.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.140",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.0",
    "@types/pg": "8.11.6",
    "esbuild": "0.21.5",
    "jest": "29.7.0",
    "ts-jest": "29.2.3",
    "typescript": "5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.ts", "**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.d.ts"]
  }
}
