{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        },
        "emulatedFormFactor": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "skipAudits": [
          "uses-http2"
        ]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.85 }
        ],
        "categories:accessibility": [
          "warn",
          { "minScore": 0.9 }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.85 }
        ],
        "categories:seo": [
          "warn",
          { "minScore": 0.8 }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500 }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1 }
        ],
        "max-potential-fid": [
          "warn",
          { "maxNumericValue": 100 }
        ],
        "total-blocking-time": [
          "warn",
          { "maxNumericValue": 300 }
        ],
        "speed-index": [
          "warn",
          { "maxNumericValue": 3400 }
        ],
        "first-contentful-paint": [
          "warn",
          { "maxNumericValue": 1800 }
        ],
        "interactive": [
          "warn",
          { "maxNumericValue": 3800 }
        ],
        "uses-responsive-images": [
          "warn",
          { "maxLength": 0 }
        ],
        "uses-optimized-images": [
          "warn",
          { "maxLength": 0 }
        ],
        "render-blocking-resources": [
          "warn",
          { "maxLength": 0 }
        ],
        "unused-javascript": [
          "warn",
          { "maxNumericValue": 0 }
        ],
        "unused-css-rules": [
          "warn",
          { "maxNumericValue": 0 }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
