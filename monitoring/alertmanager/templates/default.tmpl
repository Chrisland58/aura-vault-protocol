{{ define "slack.color" -}}
  {{- if eq .Status "resolved" -}}
    good
  {{- else if eq .CommonLabels.severity "critical" -}}
    danger
  {{- else if eq .CommonLabels.severity "warning" -}}
    warning
  {{- else -}}
    #439FE0
  {{- end -}}
{{ end }}

{{ define "slack.title" -}}
  [{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}]
  {{- " " -}}
  {{ .GroupLabels.alertname }}
  {{- if .CommonLabels.environment }} ({{ .CommonLabels.environment }}){{ end }}
{{ end }}

{{ define "slack.text" -}}
  {{- if .CommonAnnotations.summary }}
*Summary:* {{ .CommonAnnotations.summary }}
  {{- end }}

  {{- if .CommonAnnotations.description }}
*Details:* {{ .CommonAnnotations.description }}
  {{- end }}

  {{- if .Alerts.Firing }}
*Firing Alerts ({{ .Alerts.Firing | len }}):*
    {{- range .Alerts.Firing }}
• *{{ .Labels.alertname }}*{{ if .Labels.instance }} — `{{ .Labels.instance }}`{{ end }}
      {{- if .Annotations.summary }}
  {{ .Annotations.summary }}
      {{- end }}
      {{- if .Annotations.runbook_url }}
  :book: <{{ .Annotations.runbook_url }}|Runbook>
      {{- end }}
    {{- end }}
  {{- end }}

  {{- if .Alerts.Resolved }}
*Resolved Alerts ({{ .Alerts.Resolved | len }}):*
    {{- range .Alerts.Resolved }}
• *{{ .Labels.alertname }}*{{ if .Labels.instance }} — `{{ .Labels.instance }}`{{ end }}
    {{- end }}
  {{- end }}
{{ end }}

{{ define "slack.silenceURL" -}}
  http://alertmanager:9093/#/silences/new?filter=%7B
  {{- range $i, $label := .CommonLabels.SortedPairs -}}
    {{- if $i }},{{ end -}}
    {{- $label.Name }}%3D"{{- $label.Value -}}"
  {{- end -}}
  %7D
{{ end }}

{{ define "pagerduty.description" -}}
  [{{ .Status | toUpper }}]
  {{- " " -}}
  {{ .GroupLabels.alertname }}
  {{- if .CommonLabels.environment }} | {{ .CommonLabels.environment }}{{ end }}
  {{- if .CommonLabels.namespace }} | ns:{{ .CommonLabels.namespace }}{{ end }}
  {{- if .CommonAnnotations.summary }}
  — {{ .CommonAnnotations.summary }}
  {{- end }}
{{ end }}
