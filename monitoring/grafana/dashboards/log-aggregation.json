{
  "dashboard": {
    "id": null,
    "uid": "aura-vault-logs",
    "title": "Aura Vault — Log Aggregation",
    "description": "Centralized log view for all Aura Vault services via Loki. Supports LogQL queries for frontend, backend, postgres, redis, and contract-indexer.",
    "tags": ["aura-vault", "logs", "loki"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "editable": true,
    "graphTooltip": 1,
    "panels": [

      {
        "id": 1,
        "title": "Log Volume by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "sum by (service) (rate({namespace=~\"$namespace\", environment=~\"$environment\"}[5m]))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "fillOpacity": 10, "lineWidth": 1 }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
        }
      },

      {
        "id": 2,
        "title": "Error Rate by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "sum by (service) (rate({namespace=~\"$namespace\", environment=~\"$environment\", level=~\"error|ERROR|Error\"}[5m]))",
            "legendFormat": "{{service}} errors",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 20, "lineWidth": 2 }
          }
        }
      },

      {
        "id": 3,
        "title": "Frontend Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 12, "x": 0, "y": 16 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{service=\"frontend\", namespace=~\"$namespace\", environment=~\"$environment\"} |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 4,
        "title": "Backend Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 12, "x": 12, "y": 16 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{service=\"backend\", namespace=~\"$namespace\", environment=~\"$environment\"} |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 5,
        "title": "PostgreSQL Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 12, "x": 0, "y": 28 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{service=\"postgres\", namespace=~\"$namespace\", environment=~\"$environment\"} |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 6,
        "title": "Redis Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 12, "x": 12, "y": 28 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{service=\"redis\", namespace=~\"$namespace\", environment=~\"$environment\"} |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 7,
        "title": "Contract Indexer Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{service=\"contract-indexer\", namespace=~\"$namespace\", environment=~\"$environment\"} |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 8,
        "title": "All Error Logs",
        "type": "logs",
        "gridPos": { "h": 14, "w": 24, "x": 0, "y": 52 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "{namespace=~\"$namespace\", environment=~\"$environment\"} |~ `(?i)(error|fatal|panic|exception|critical)` |= `$search`",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true,
          "dedupStrategy": "signature",
          "sortOrder": "Descending"
        }
      },

      {
        "id": 9,
        "title": "Log Level Distribution (last 24h)",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 66 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "sum by (level) (count_over_time({namespace=~\"$namespace\", environment=~\"$environment\"}[24h]))",
            "legendFormat": "{{level}}",
            "refId": "A",
            "instant": true
          }
        ]
      },

      {
        "id": 10,
        "title": "Top 10 Error Messages",
        "type": "table",
        "gridPos": { "h": 8, "w": 16, "x": 8, "y": 66 },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "targets": [
          {
            "expr": "topk(10, sum by (service, level) (count_over_time({namespace=~\"$namespace\", environment=~\"$environment\", level=~\"error|ERROR\"}[1h])))",
            "legendFormat": "{{service}} [{{level}}]",
            "refId": "A",
            "instant": true
          }
        ],
        "options": {
          "sortBy": [{ "displayName": "Value", "desc": true }]
        }
      }

    ],

    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "label": "Loki Datasource",
          "pluginId": "loki",
          "refresh": 1,
          "current": { "text": "Loki", "value": "Loki" }
        },
        {
          "name": "namespace",
          "type": "query",
          "label": "Namespace",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "query": "label_values(namespace)",
          "refresh": 2,
          "includeAll": true,
          "allValue": ".*",
          "current": { "text": "All", "value": ".*" }
        },
        {
          "name": "environment",
          "type": "query",
          "label": "Environment",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "query": "label_values(environment)",
          "refresh": 2,
          "includeAll": true,
          "allValue": ".*",
          "current": { "text": "All", "value": ".*" }
        },
        {
          "name": "search",
          "type": "textbox",
          "label": "Search",
          "current": { "text": "", "value": "" }
        }
      ]
    },

    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "{namespace=~\"$namespace\"} |= \"deployed\" |= \"version\"",
          "enable": true,
          "hide": false,
          "iconColor": "blue",
          "textFormat": "{{service}} deployed"
        }
      ]
    }
  },
  "overwrite": true
}
