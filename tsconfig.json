{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": [
    "playwright/**/*.ts",
    "playwright/**/*.spec.ts"
  ]
}
