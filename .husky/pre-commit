#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged: eslint --fix + prettier on JS/TS, rustfmt on Rust
npx lint-staged

# Run cargo clippy only when Rust files are staged
STAGED_RUST=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RUST" ]; then
  echo "Running cargo clippy on staged Rust files..."
  cargo clippy --manifest-path aura-vault/Cargo.toml -- -D warnings
fi
