# issue #499: exclude files that should not enter the Docker build context

# Version control
.git
.gitignore

# Dependencies (installed fresh inside the container)
node_modules

# Build outputs (rebuilt inside the container)
dist

# Test files
**/*.test.ts
**/*.spec.ts
src/tests/
src/scripts/*.test.ts

# Local environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode
.idea

# Docs and misc
*.md
README*
Dockerfile*
