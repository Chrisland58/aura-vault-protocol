{
  "$schema": "https://json.schemastore.org/budget",
  "version": "1.0.0",
  "description": "Frontend performance budget for Aura Vault Protocol. Enforced by size-limit in CI.",
  "budgets": [
    {
      "type": "bundle",
      "name": "Main JS bundle",
      "path": ".next/static/chunks/main-*.js",
      "maximumWarning": "180kb",
      "maximumError": "200kb",
      "notes": "Gzip-compressed. Exceeding this limit will fail the CI build."
    },
    {
      "type": "bundle",
      "name": "Framework chunk (React + Next.js runtime)",
      "path": ".next/static/chunks/framework-*.js",
      "maximumWarning": "45kb",
      "maximumError": "50kb",
      "notes": "Gzip-compressed. React + Next.js runtime, rarely changes."
    },
    {
      "type": "route",
      "name": "Home page ( / )",
      "path": ".next/static/chunks/pages/index-*.js",
      "maximumWarning": "40kb",
      "maximumError": "50kb",
      "notes": "Gzip-compressed per-route chunk."
    },
    {
      "type": "route",
      "name": "Dashboard ( /dashboard )",
      "path": ".next/static/chunks/pages/dashboard-*.js",
      "maximumWarning": "40kb",
      "maximumError": "50kb",
      "notes": "Gzip-compressed per-route chunk."
    },
    {
      "type": "route",
      "name": "FAQ page ( /faq )",
      "path": ".next/static/chunks/pages/faq-*.js",
      "maximumWarning": "40kb",
      "maximumError": "50kb",
      "notes": "Gzip-compressed per-route chunk."
    },
    {
      "type": "route",
      "name": "Settings page ( /settings )",
      "path": ".next/static/chunks/pages/settings-*.js",
      "maximumWarning": "40kb",
      "maximumError": "50kb",
      "notes": "Gzip-compressed per-route chunk."
    },
    {
      "type": "stylesheet",
      "name": "Global CSS bundle",
      "path": ".next/static/css/*.css",
      "maximumWarning": "15kb",
      "maximumError": "20kb",
      "notes": "Gzip-compressed. Includes Tailwind purged output."
    }
  ],
  "thresholds": {
    "mainBundle": {
      "gzip": "200kb",
      "rationale": "Keeps initial load fast on 3G (~1.3 s @ 1.5 Mbit/s)."
    },
    "perRouteChunk": {
      "gzip": "50kb",
      "rationale": "Route-level code splitting; each page loads only what it needs."
    },
    "cssBundle": {
      "gzip": "20kb",
      "rationale": "Tailwind CSS with PurgeCSS; large CSS blocks rendering."
    }
  }
}
