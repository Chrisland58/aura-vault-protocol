[
  {
    "name": "Main JS bundle",
    "path": ".next/static/chunks/main-*.js",
    "limit": "200 kB",
    "gzip": true
  },
  {
    "name": "Framework chunk",
    "path": ".next/static/chunks/framework-*.js",
    "limit": "50 kB",
    "gzip": true
  },
  {
    "name": "Per-route chunks",
    "path": ".next/static/chunks/pages/**/*.js",
    "limit": "50 kB",
    "gzip": true
  },
  {
    "name": "CSS bundle",
    "path": ".next/static/css/*.css",
    "limit": "20 kB",
    "gzip": true
  }
]
